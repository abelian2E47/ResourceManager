{
	"schemaVersion": 1,
	"id": "resourcemanager",
	"version": "${version}",
	"name": "ResourceManager",
	"description": "Search items, blocks and creatures in a vanilla-style inventory. Preview and edit related textures, names and sounds, choose one appearance pack per object, and switch sound layers independently. Open with F8.",
	"authors": [
		"Ay2E47"
	],
	"license": "MIT",
	"icon": "assets/resourcemanager/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.abelian.ResourceManager"
		],
		"client": [
			"com.abelian.client.ResourceManagerClient"
		]
	},
	"mixins": [
		"resourcemanager.mixins.json",
		{
			"config": "resourcemanager.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	}
}